# NIO Selector 多路复用原理
direction: down

Selector: {
  label: "Selector\n单线程事件循环（select()）"
  style.fill: "#E3E9FD"
}

Selector -> ch1: OP_READ 就绪
Selector -> ch2: 空闲（无就绪事件）
Selector -> ch3: OP_WRITE 就绪

ch1: SocketChannel-1 {
  style.fill: "#E8F5E9"
}
ch2: SocketChannel-2 {
  style.fill: "#F7F8FE"
}
ch3: SocketChannel-3 {
  style.fill: "#E8F5E9"
}

ch1 -> buf1: read() 读取到用户态
ch3 -> buf2: write() 从用户态写出

buf1: ByteBuffer {
  style.fill: "#EEF1F8"
}
buf2: ByteBuffer {
  style.fill: "#EEF1F8"
}