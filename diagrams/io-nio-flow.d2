# NIO — 同步非阻塞（阶段1不等 + 阶段2自己拷）

direction: down

call1: "线程调用 read(fd, buf, size)\n-> 文件描述符已设为非阻塞" {
  style.fill: "#e8eaf6"
}

poll1: {
  label: "第 N 次轮询：数据未到"
  style.fill: "#fff3e0"

  t: "线程 -> TASK_RUNNING（不挂起）\nread() 立刻返回 0\n线程继续跑，可以 check 其他连接" {
    style.fill: "#ffe0b2"
  }

  k: "内核：Socket 缓冲区空的\n立即告诉线程: 没有数据" {
    style.fill: "#ffcc80"
  }
}

arrow: "...... 反复轮询若干次 ......" {
  style.fill: "#f5f5f5"
}

call2: "线程再次调用 read(fd, buf, size)\n-> 这次数据到了" {
  style.fill: "#c8e6c9"
}

stage2: {
  label: "阶段2：拷贝数据（有数据了，所以堵）"
  style.fill: "#e3f2fd"

  t2: "线程 -> 参与拷贝\n这次 read() 不会立刻返回\n耗时 ~5us" {
    style.fill: "#90caf9"
  }

  k2: "内核：Socket buf -> 用户 buf\nmemcpy 执行中" {
    style.fill: "#64b5f6"
  }
}

ret: "read() 返回 1024 -> buf 里有数据" {
  style.fill: "#a5d6a7"
}

call1 -> poll1.k
call1 -> poll1.t
poll1 -> arrow
arrow -> call2
call2 -> stage2.k2 -> stage2.t2
stage2 -> ret
