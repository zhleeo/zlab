direction: right

client: "客户端" {style.fill: "#e3f2fd"; style.stroke: "#64b5f6"}

queues: "" {
  direction: down
  synq: "SYN 队列（半连接）\n已收到 SYN，握手未完成\n上限 tcp_max_syn_backlog" {style.fill: "#fff3e0"; style.stroke: "#ffb74d"}
  accq: "ACCEPT 队列（全连接）\n握手已完成，等待 accept()\n上限 min(backlog, somaxconn)" {style.fill: "#c8e6c9"; style.stroke: "#66bb6a"}
}

app: "应用进程\naccept() 取走连接" {style.fill: "#e8f5e9"; style.stroke: "#66bb6a"}

client -> queues.synq: "① SYN"
queues.synq -> client: "② SYN+ACK"
client -> queues.accq: "③ ACK → 移入 ACCEPT 队列"
queues.accq -> app: "④ accept() 返回"